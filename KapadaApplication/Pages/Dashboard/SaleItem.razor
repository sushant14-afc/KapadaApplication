@page "/sales"
@inject HttpClient Http
@using KapadaModel.DBOs
@using System.Net.Http.Json

<h3 class="mb-4">Available Inventory for Sale</h3>

<!-- Filter UI Section -->
<div class="row mb-4">
    <div class="col-md-4">
        <label for="dateFilter" class="form-label">Filter by Date:</label>
        <InputDate id="dateFilter" @bind-Value="filterDate" class="form-control" />
    </div>

    <div class="col-md-4">
        <label for="categoryFilter" class="form-label">Filter by Category:</label>
        <InputSelect id="categoryFilter" @bind-Value="filterCategory" class="form-control">
            <option value="">-- Select Category --</option>
            @foreach (var item in Categories)
            {
                <option value="@item.Name">@item.Name</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-4">
        <label for="roomFilter" class="form-label">Filter by Room:</label>
        <InputSelect id="roomFilter" @bind-Value="filterRoom" class="form-control">
            <option value="">-- Select Room --</option>
            @foreach (var room in Rooms)
            {
                <option value="@room.RoomName">@room.RoomName</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-8 d-flex align-items-end gap-2 mt-3">
        <button class="btn btn-primary" @onclick="LoadFilteredData">Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearFilter">Clear</button>
    </div>
</div>

@if (inventoryItems == null)
{
    <p><em>Loading...</em></p>
}
else if (!inventoryItems.Any())
{

    <p>No available inventory items for sale.</p>  
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Room</th>
                <th>Quantity (Meters)</th>
                <th>Created Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in inventoryItems)
            {
                <tr>
                    <td>@item.CategoryName</td>
                    <td>@item.RoomName</td>
                    <td>@item.Quantity</td>
                    <td>@item.CreatedDate.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="() => OpenSaleDialog(item)">Sell</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showDialog && selectedItem != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sell Inventory</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Category:</strong> @selectedItem.CategoryName</p>
                    <p><strong>Room:</strong> @selectedItem.RoomName</p>
                    <p><strong>Quantity:</strong> @selectedItem.Quantity</p>

                    <div class="mb-3">
                        <label for="soldTo" class="form-label">Sold To</label>
                        <input type="text" class="form-control" id="soldTo" @bind="buyerName" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmSale">Confirm Sale</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RoomDBO> Rooms = new();
    private List<GroupedInventoryResponse>? groupedInventoryItems;
    private List<CategoryItemDBO> Categories = new();
    private string? filterRoom;
    private string? filterCategory;
    private DateTime? filterDate;



    private List<InventoryResponse>? inventoryItems;
    private InventoryResponse? selectedItem;
    private bool showDialog = false;
    private string buyerName = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Rooms = await Http.GetFromJsonAsync<List<RoomDBO>>("api/room/getRoom");
        Categories = await Http.GetFromJsonAsync<List<CategoryItemDBO>>("api/category/getCategories");
        inventoryItems = await Http.GetFromJsonAsync<List<InventoryResponse>>("api/sale/available");
        groupedInventoryItems = await Http.GetFromJsonAsync<List<GroupedInventoryResponse>>("api/sale/available-grouped");
        await LoadAvailableInventory();
    }

    private async Task LoadFilteredData()
    {
        var queryParams = new List<string>();
        if (filterDate.HasValue)
            queryParams.Add($"date={filterDate.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(filterRoom))
            queryParams.Add($"room={Uri.EscapeDataString(filterRoom)}");
        if (!string.IsNullOrWhiteSpace(filterCategory))
            queryParams.Add($"category={Uri.EscapeDataString(filterCategory)}");

        var query = string.Join("&", queryParams);

        inventoryItems = string.IsNullOrWhiteSpace(query)
            ? await Http.GetFromJsonAsync<List<InventoryResponse>>("api/sale/available")
            : await Http.GetFromJsonAsync<List<InventoryResponse>>($"api/sale/filter?{query}");
    }

    private async Task ClearFilter()
    {
        filterDate = null;
        filterRoom = null;
        filterCategory = null;
        await LoadAvailableInventory();
    }

    private async Task LoadAvailableInventory()
    {
        inventoryItems = await Http.GetFromJsonAsync<List<InventoryResponse>>("api/sale/available");
    }

    private void OpenSaleDialog(InventoryResponse item)
    {
        selectedItem = item;
        buyerName = string.Empty;
        errorMessage = string.Empty;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        selectedItem = null;
        buyerName = string.Empty;
    }

    private async Task ConfirmSale()
    {
        if (string.IsNullOrWhiteSpace(buyerName))
        {
            errorMessage = "Please enter buyer name.";
            return;
        }

        var saleDto = new SalesCreateDBO
            {
                InventoryId = selectedItem!.Id,
                SoldTo = buyerName
            };

        var response = await Http.PostAsJsonAsync("api/sale/createSale", saleDto);
        if (response.IsSuccessStatusCode)
        {
            inventoryItems!.Remove(selectedItem!);
            CloseDialog();
        }
        else
        {
            errorMessage = "Failed to record sale. Try again.";
        }
    }
}
