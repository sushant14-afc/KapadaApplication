@page "/register"
@using KapadaModel.DBOs
@inject HttpClient Http

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="card shadow-sm rounded-4 p-4" style="width: 100%; max-width: 420px;">
       
        <!-- Illustration and Header -->
        <div class="text-center mb-4">
            <h4 class="fw-semibold mb-1">Create an Account</h4>
            <p class="text-muted small mb-0">Register to continue</p>
        </div>

        <!-- Form -->
        <EditForm Model="registerModel" OnValidSubmit="HandleRegister" class="needs-validation" novalidate>
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="username" class="form-label fw-medium">Username</label>
                <InputText id="username" class="form-control rounded-3 form-control-sm" @bind-Value="registerModel.Username" />
                <ValidationMessage For="@(() => registerModel.Username)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-medium">Password</label>
                <InputText id="password" type="password" class="form-control rounded-3 form-control-sm" @bind-Value="registerModel.Password" />
                <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label fw-medium">Confirm Password</label>
                <InputText id="confirmPassword" type="password" class="form-control rounded-3 form-control-sm" @bind-Value="registerModel.ConfirmPassword" />
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger small" />
            </div>

            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary rounded-pill">Register</button>
            </div>
        </EditForm>

        <!-- Success or Error Message -->
        @if (showMessage)
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show mt-3 text-center small" role="alert">
                @apiMessage
                <button type="button" class="btn-close" @onclick="() => showMessage = false" aria-label="Close"></button>
            </div>
        }

        <!-- Bottom Link -->
        <div class="text-center mt-3">
            <small class="text-muted">Already have an account? <a href="/login">Login</a></small>
        </div>
    </div>
</div>




@code {
    private RegisterUserDBO registerModel = new();

    private string apiMessage = string.Empty;
    private bool isSuccess = false;
    private bool showMessage = false;


    
    private async Task HandleRegister()
    {
        apiMessage = string.Empty;
        isSuccess = false;
        showMessage = false;

        try
        {
            var response = await Http.PostAsJsonAsync("api/users/register", registerModel);
            var message = await response.Content.ReadAsStringAsync();

            showMessage = true;
            apiMessage = message;

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                registerModel = new();
            }
            else
            {
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            apiMessage = $"An unexpected error occurred: {ex.Message}";
            showMessage = true;
        }
    }

    
}
