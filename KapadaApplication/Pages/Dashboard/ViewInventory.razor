@page "/history"
@using KapadaApplication.Services
@using KapadaModel.DBOs
@inject UserService Session
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title mb-4 text-center">Inventory History</h4>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label for="dateFilter" class="form-label">Filter by Date:</label>
                    <InputDate id="dateFilter" @bind-Value="filterDate" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label for="categoryFilter" class="form-label">Filter by Item Name:</label>
                    <InputSelect id="categoryFilter" @bind-Value="filterCategory" class="form-control">
                        <option value="">-- Select Category --</option>
                        @foreach (var item in Category)
                        {
                            <option value="@item.Name">@item.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label for="roomFilter" class="form-label">Filter by Room:</label>
                    <InputSelect id="roomFilter" @bind-Value="filterRoom" class="form-control">
                        <option value="">-- Select Room --</option>
                        @foreach (var room in Rooms)
                        {
                            <option value="@room.RoomName">@room.RoomName</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-8 d-flex align-items-end gap-2 mt-3">
                    <button class="btn btn-primary" @onclick="LoadFilteredData">Filter</button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilter">Clear Filter</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Category</th>
                            <th>Room</th>
                            <th>Quantity(Meters)</th>
                            <th>Item Added Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedInventories.Any())
                        {
                            @foreach (var inv in PagedInventories)
                            {
                                <tr>
                                    <td>@inv.CategoryName</td>
                                    <td>@inv.RoomName</td>
                                    <td>@inv.Quantity</td>
                                    <td>@inv.CreatedDate.ToShortDateString()</td>
                                    <td>
                                        @if (inv.IsSold)
                                        {
                                            <span class="badge bg-danger">Sold</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No records found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <button class="btn btn-outline-primary" @onclick="PreviousPage" disabled="@(_currentPage == 1)">Previous</button>
                <span>Page @_currentPage of @_totalPages</span>
                <button class="btn btn-outline-primary" @onclick="NextPage" disabled="@(_currentPage == _totalPages)">Next</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string? filterRoom;
    private List<RoomDBO> Rooms = new();

    private string? filterCategory;
    private List<CategoryItemDBO> Category = new();

    private List<InventoryResponse> Inventories = new();
    private List<InventoryResponse> PagedInventories = new();

    private DateTime? filterDate;

    private int _currentPage = 1;
    private int _pageSize = 5; // Change as needed
    private int _totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadCategory();
        await LoadRooms();
        await LoadAllData();
    }

    private async Task LoadRooms()
    {
        Rooms = await Http.GetFromJsonAsync<List<RoomDBO>>("api/room/getRoom"); 
    }

    private async Task LoadCategory()
    {
        Category = await Http.GetFromJsonAsync<List<CategoryItemDBO>>("api/category/getCategories");
    }

    private async Task LoadAllData()
    {
        Inventories = await Http.GetFromJsonAsync<List<InventoryResponse>>("api/inventory/getInventories");
        UpdatePagination();
    }

    private async Task LoadFilteredData()
    {
        if (filterDate.HasValue || !string.IsNullOrWhiteSpace(filterRoom) || !string.IsNullOrWhiteSpace(filterCategory))
        {
            var queryParams = new List<string>();
            if (filterDate.HasValue)
                queryParams.Add($"date={filterDate.Value:yyyy-MM-dd}");
            if (!string.IsNullOrWhiteSpace(filterRoom))
                queryParams.Add($"room={Uri.EscapeDataString(filterRoom)}");
            if (!string.IsNullOrWhiteSpace(filterCategory))
                queryParams.Add($"category={Uri.EscapeDataString(filterCategory)}");

            var query = string.Join("&", queryParams);
            Inventories = await Http.GetFromJsonAsync<List<InventoryResponse>>($"api/inventory/filter?{query}");
        }
        else
        {
            await LoadAllData();
        }

        _currentPage = 1;
        UpdatePagination();
    }

    private async Task ClearFilter()
    {
        if (filterDate.HasValue || !string.IsNullOrWhiteSpace(filterRoom) || !string.IsNullOrWhiteSpace(filterCategory))
        {
            filterDate = null;
            filterRoom = null;
            filterCategory = null;
            _currentPage = 1;
            await LoadAllData();
        }

        
        
    }

    private void UpdatePagination()
    {
        _totalPages = (int)Math.Ceiling(Inventories.Count / (double)_pageSize);
        PagedInventories = Inventories
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            UpdatePagination();
        }
    }
}