@page "/sell"
@inject HttpClient Http
@using KapadaModel.DBOs
@using System.Net.Http.Json
@inject NavigationManager Navigation

<h3 class="mb-4">Grouped Inventory for Sale</h3>

@if (groupedInventoryItems == null)
{
    <p><em>Loading...</em></p>
}
else if (!groupedInventoryItems.Any())
{
    <p>No grouped inventory data available.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Total Quantity (Meters)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in groupedInventoryItems)
            {
                <tr>
                    <td>@group.Category</td>
                    <td>@group.Rooms.Sum(r => r.TotalQuantity)</td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="() => OpenSaleDialog(group.Category)">View</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showDialog && categoryToSell != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sell Item from Category: @categoryToSell</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    @if (categoryItems == null || !categoryItems.Any())
                    {
                        <p>No items found in this category.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Room</th>
                                    <th>Quantity</th>
                                    <th>Created Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in categoryItems)
                                {
                                    <tr>
                                        <td>@item.RoomName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.CreatedDate.ToShortDateString()</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" @onclick="() => SelectItemForSale(item)">Sell</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-primary btn-sm" @onclick="() => EditItem(item)">Edit</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (selectedItemToSell != null)
                    {
                        <hr />
                        <div class="mb-3">
                            <label>Selected Room: <strong>@selectedItemToSell.RoomName</strong></label><br />
                            <label>Quantity: <strong>@selectedItemToSell.Quantity</strong></label>
                        </div>

                        <div class="mb-3">
                            <label for="soldTo">Sold To:</label>
                            <input id="soldTo" class="form-control" @bind="buyerName" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmSale" disabled="@(!CanConfirmSale)">Confirm Sale</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<GroupedInventoryResponse>? groupedInventoryItems;
    private List<InventoryResponse>? categoryItems;
    private InventoryResponse? selectedItemToSell;
    private string? categoryToSell;
    private string buyerName = string.Empty;
    private string errorMessage = string.Empty;
    private bool showDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupedData();
    }

    private async Task LoadGroupedData()
    {
        groupedInventoryItems = await Http.GetFromJsonAsync<List<GroupedInventoryResponse>>("api/sale/available-grouped");
    }

    private async Task OpenSaleDialog(string categoryName)
    {
        categoryToSell = categoryName;
        categoryItems = await Http.GetFromJsonAsync<List<InventoryResponse>>($"api/sale/category-items?category={Uri.EscapeDataString(categoryName)}");
        selectedItemToSell = null;
        buyerName = string.Empty;
        errorMessage = string.Empty;
        showDialog = true;
    }

    private void SelectItemForSale(InventoryResponse item)
    {
        selectedItemToSell = item;
        errorMessage = string.Empty;
    }

    private void EditItem(InventoryResponse item)
    {
        Navigation.NavigateTo($"/add-item/{item.Id}");
    }

    private async Task ConfirmSale()
    {
        if (string.IsNullOrWhiteSpace(buyerName))
        {
            errorMessage = "Please enter buyer name.";
            return;
        }

        if (selectedItemToSell == null)
        {
            errorMessage = "Please select an item to sell.";
            return;
        }

        var saleDto = new SalesCreateDBO
            {
                InventoryId = selectedItemToSell.Id,
                SoldTo = buyerName
            };

        var response = await Http.PostAsJsonAsync("api/sale/createSale", saleDto);

        if (response.IsSuccessStatusCode)
        {
            categoryItems!.Remove(selectedItemToSell);

            var group = groupedInventoryItems!.Find(c => c.Category == categoryToSell);
            if (group != null)
            {
                var room = group.Rooms.Find(r => r.RoomName == selectedItemToSell.RoomName);
                if (room != null)
                {
                    room.TotalQuantity -= selectedItemToSell.Quantity;
                    if (room.TotalQuantity <= 0)
                    {
                        group.Rooms.Remove(room);
                    }
                }

                if (!group.Rooms.Any())
                {
                    groupedInventoryItems.Remove(group);
                }
            }

            CloseDialog();
        }

        else
        {
            errorMessage = "Failed to record sale.";
        }
    }

    private void CloseDialog()
    {
        showDialog = false;
        categoryToSell = null;
        selectedItemToSell = null;
        buyerName = string.Empty;
        errorMessage = string.Empty;
    }

    private bool CanConfirmSale => selectedItemToSell != null && !string.IsNullOrWhiteSpace(buyerName);
}
