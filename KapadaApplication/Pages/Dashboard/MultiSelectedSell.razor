@page "/sell"
@inject HttpClient Http
@using KapadaApplication.Services
@using KapadaModel.DBOs
@inject UserService Session
@using System.Net.Http.Json
@inject NavigationManager Navigation

<h3 class="mb-4 text-center">Grouped Inventory for Sale</h3>

<div class="row mb-4">
    <div class="col-md-4">
        <label for="categoryFilter" class="form-label fw-semibold">Filter by Category:</label>
        <InputSelect id="categoryFilter" @bind-Value="filterCategory" class="form-select">
            <option value="">-- Select Category --</option>
            @foreach (var item in Category)
            {
                <option value="@item.Name">@item.Name</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-4 d-flex align-items-end gap-2">
        <button class="btn btn-primary" @onclick="LoadFilteredCategoryData">Filter</button>
        <button class="btn btn-outline-secondary" @onclick="ClearCategoryFilter">Clear</button>
    </div>
</div>

@if (groupedInventoryItems == null)
{
    <p><em>Loading...</em></p>
}
else if (!groupedInventoryItems.Any())
{
    <p>No grouped inventory data available.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Total Quantity (Meters)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in groupedInventoryItems)
            {
                <tr>
                    <td>@group.Category</td>
                    <td>@group.Rooms.Sum(r => r.TotalQuantity)</td>
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="() => OpenSaleDialog(group.Category)">View</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showDialog && categoryToSell != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sell Item(s) from Category: @categoryToSell</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">

                    <!-- Filters -->

                    <div class="row mb-3 align-items-end">
                        <div class="col-md-4">
                            <label for="roomFilter" class="form-label fw-semibold">Filter by Room:</label>
                            <InputSelect id="roomFilter" @bind-Value="filterRoom" class="form-select">
                                <option value="">-- Select Room --</option>
                                @foreach (var room in Rooms)
                                {
                                    <option value="@room.RoomName">@room.RoomName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label for="dateFilter" class="form-label fw-semibold">Filter by Date:</label>
                            <input id="dateFilter" type="date" class="form-control" @bind="filterDate" />
                        </div>

                        <div class="col-md-3">
                            <label for="quantityFilter" class="form-label fw-semibold">Filter by Quantity:</label>
                            <InputSelect id="quantityFilter" @bind-Value="filterQuantity" class="form-select">
                                <option value="">-- Select Quantity --</option>
                                @foreach (var qty in AvailableQuantities)
                                {
                                    <option value="@qty">@qty</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Buttons Row -->
                    <div class="row mb-4">
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-primary" @onclick="ApplyFilters">Filter</button>
                        </div>

                        <div class="col-md-2 d-grid">
                            <button class="btn btn-outline-danger" @onclick="ClearFilters">Clear</button>
                        </div>
                    </div>


                    @if (filteredItems == null || !filteredItems.Any())
                    {
                        <p>No items found for the selected filters.</p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>
                                        <input type="checkbox" checked="@selectAll" @onchange="OnSelectAllChanged" />
                                    </th>
                                    <th>Room</th>
                                    <th>Quantity</th>
                                    <th>Category Added Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in PaginatedItems)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" @bind="item.IsSelected" />
                                        </td>
                                        <td>@item.RoomName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.CreatedDate.ToShortDateString()</td>
                                        <td>
                                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditItem(item)">Edit</button>
                                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(item)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Pagination Controls -->
                        <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                            <button class="btn btn-outline-primary" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">Previous</button>
                            <span>Page @CurrentPage of @TotalPages</span>
                            <button class="btn btn-outline-primary" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Next</button>
                        </div>

                        <!-- Sell Selected Button -->
                        <button class="btn btn-success mt-3" @onclick="OpenMultiSellSection" disabled="@(!SelectedItems.Any())">
                            Sell Selected (@SelectedItems.Count())
                        </button>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger mt-2">@errorMessage</div>
                        }
                    }

                    @if (showMultiSellSection)
                    {
                        <hr />
                        <div>
                            <h5>Selling @SelectedItems.Count() item(s)</h5>

                            <p>Total Quantity: <strong>@TotalSelectedQuantity</strong></p>

                            <div class="mb-3">
                                <label for="buyerNameMulti">Sold To:</label>
                                <input id="buyerNameMulti" class="form-control" @bind="buyerName" />
                            </div>

                            <div class="mb-3">
                                <label for="pricePerMeterMulti">Price per Meter:</label>
                                <input id="pricePerMeterMulti" type="number" step="0.01" min="0" class="form-control" @bind="pricePerMeter" />
                            </div>

                            @if (pricePerMeter > 0)
                            {
                                <div class="mb-3">
                                    <label>Total Price:</label>
                                    <div><strong>Rs.@((TotalSelectedQuantity * pricePerMeter).ToString("F2"))</strong></div>
                             </div>
                            }

                            <button class="btn btn-primary" @onclick="ShowConfirmDialog" disabled="@(!CanConfirmMultiSale)">
                                    Confirm Sale
                            </button>
                            <button class="btn btn-secondary ms-2" @onclick="CancelMultiSell">Cancel</button>
                        </div>
                    }

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
}
@if (showConfirmDialog)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg rounded-4 border-0">

                <!-- HEADER -->
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-receipt"></i> Category Detail
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseConfirmDialog"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">

                    <!-- Key Info -->
                    <div class="mb-3 p-3 bg-light rounded-3">
                        <div class="d-flex flex-wrap gap-3">
                            <div>
                                <small class="text-muted">Category</small>
                                <div class="fw-semibold fs-5">@categoryToSell</div>
                            </div>
                            <div>
                                <small class="text-muted">Buyer</small>
                                <div class="fw-semibold">@buyerName</div>
                            </div>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive" style="max-height: 300px;">
                        <table class="table table-sm table-hover align-middle table-striped">
                            <thead class="table-light position-sticky top-0 shadow-sm">
                                <tr>
                                    <th style="width: 40%;">Quantity (m)</th>
                                    <th style="width: 60%;">Room</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in SelectedItems)
                                {
                                    <tr>
                                        <td>@item.Quantity</td>
                                        <td>@item.RoomName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Totals -->
                    <div class="mt-3 border-top pt-3">
                        <div class="d-flex justify-content-between">
                            <strong>Total Meters:</strong>
                            <span>@TotalSelectedQuantity</span>
                        </div>
                        <div class="d-flex justify-content-between text-success fw-bold fs-5">
                            <strong>Total Price:</strong>
                            <span>Rs. @((TotalSelectedQuantity * pricePerMeter).ToString("F2"))</span>
                        </div>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button class="btn btn-success btn-lg px-4" @onclick="ConfirmMultiSale">
                        <i class="bi bi-check-circle"></i> Confirm Sale
                    </button>
                    <button class="btn btn-secondary btn-lg px-4" @onclick="CloseConfirmDialog">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>

            </div>
        </div>
    </div>
}
@if (deleteItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete "<strong>@deleteItem.Quantity</strong>" from Room "<strong>@deleteItem.RoomName</strong>"?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Delete</button>
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private decimal? filterQuantity = null;
    private List<decimal> AvailableQuantities = new();

    private bool selectAll = false;


    private string? filterCategory;
    private List<CategoryItemDBO> Category = new();
    private List<GroupedInventoryResponse>? groupedInventoryItems;

    private List<InventoryResponse>? categoryItems;
    private List<InventoryResponse>? filteredItems;
    private InventoryResponse? deleteItem;
    private string? categoryToSell;

    private string buyerName = string.Empty;
    private string errorMessage = string.Empty;
    private bool showDialog = false;
    private decimal pricePerMeter = 0m;

    // Filter inputs
    private string? filterRoom;
    private List<RoomDBO> Rooms = new();
    private DateTime? filterDate = null;

    private bool showConfirmDialog = false;
    private void ShowConfirmDialog()
    {
        showConfirmDialog = true;
    }

    private void CloseConfirmDialog()
    {
        showConfirmDialog = false;
        errorMessage = string.Empty;
    }


    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 5; 

    private int TotalPages => filteredItems == null || !filteredItems.Any()
        ? 1
        : (int)Math.Ceiling((double)filteredItems.Count / PageSize);

    private IEnumerable<InventoryResponse> PaginatedItems => filteredItems == null
        ? Enumerable.Empty<InventoryResponse>()
        : filteredItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<InventoryResponse> SelectedItems => filteredItems?.Where(i => i.IsSelected) ?? Enumerable.Empty<InventoryResponse>();

    private decimal TotalSelectedQuantity => SelectedItems.Sum(i => i.Quantity);

    private bool CanConfirmMultiSale => SelectedItems.Any() && !string.IsNullOrWhiteSpace(buyerName) && pricePerMeter > 0;

    private bool showMultiSellSection = false;

    private void OnSelectAllChanged(ChangeEventArgs e)
    {
        selectAll = (bool)e.Value;

        if (filteredItems == null)
            return;

        foreach (var item in filteredItems)
        {
            item.IsSelected = selectAll;
        }
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadRooms();
        await LoadCategory();
        await LoadGroupedData();
        await LoadAvailableQuanity();
    }

    private async Task LoadAvailableQuanity()
    {
        AvailableQuantities = await Http.GetFromJsonAsync<List<decimal>>("api/inventory/available-quantities");

    }

    private async Task LoadCategory()
    {
        Category = await Http.GetFromJsonAsync<List<CategoryItemDBO>>("api/category/getCategories");
    }

    private async Task LoadRooms()
    {
        Rooms = await Http.GetFromJsonAsync<List<RoomDBO>>("api/room/getRoom");
    }

    private async Task LoadFilteredCategoryData()
    {
        var queryParams = new List<string>();
        if (!string.IsNullOrWhiteSpace(filterCategory))
            queryParams.Add($"categoryName={Uri.EscapeDataString(filterCategory)}");

        var query = string.Join("&", queryParams);

        groupedInventoryItems = await Http.GetFromJsonAsync<List<GroupedInventoryResponse>>(
            string.IsNullOrEmpty(query)
            ? "api/sale/available-grouped"
            : $"api/sale/available-grouped?{query}"
        );
    }

    private async Task ClearCategoryFilter()
    {
        if (!string.IsNullOrWhiteSpace(filterCategory))
        {
            filterCategory = null;
            await LoadGroupedData();
        }
    }

    private async Task LoadQuantitiesForCategory(string category)
    {
        if (!string.IsNullOrWhiteSpace(category))
        {
            AvailableQuantities = await Http.GetFromJsonAsync<List<decimal>>(
                $"api/sale/available-quantities-by-category?category={Uri.EscapeDataString(category)}");
        }
        else
        {
            AvailableQuantities = new List<decimal>();
        }
    }


    private async Task LoadGroupedData()
    {
        groupedInventoryItems = await Http.GetFromJsonAsync<List<GroupedInventoryResponse>>("api/sale/available-grouped");
    }

    private async Task OpenSaleDialog(string categoryName)
    {
        categoryToSell = categoryName;
        categoryItems = await Http.GetFromJsonAsync<List<InventoryResponse>>($"api/sale/category-items?category={Uri.EscapeDataString(categoryName)}");

        // Initialize filteredItems and reset selections
        if (categoryItems != null)
        {
            filteredItems = categoryItems.Select(i => { i.IsSelected = false; return i; }).ToList();
        }
        else
        {
            filteredItems = new List<InventoryResponse>();
        }

        await LoadQuantitiesForCategory(categoryName);  //Load quantities here


        ClearFilters(); 
        errorMessage = string.Empty;
        buyerName = string.Empty;
        pricePerMeter = 0m;
        showMultiSellSection = false;
        showDialog = true;
        CurrentPage = 1;
    }


    private void ApplyFilters()
    {
        if (categoryItems == null)
        {
            filteredItems = new List<InventoryResponse>();
            selectAll = false;
            return;
        }

        filteredItems = categoryItems.Where(item =>
            (string.IsNullOrWhiteSpace(filterRoom) || item.RoomName.Contains(filterRoom, StringComparison.OrdinalIgnoreCase)) &&
            (!filterDate.HasValue || item.CreatedDate.Date == filterDate.Value.Date) &&
            (!filterQuantity.HasValue || item.Quantity == filterQuantity.Value)
            ).Select(i => { i.IsSelected = false; return i; }).ToList();

        selectAll = false;
        CurrentPage = 1;
    }

    private void ClearFilters()
    {
        filterRoom = string.Empty;
        filterDate = null;
        filterQuantity = null;

        if (categoryItems != null)
            filteredItems = categoryItems.Select(i => { i.IsSelected = false; return i; }).ToList();
        selectAll = false;
        CurrentPage = 1;
    }

    private void EditItem(InventoryResponse item)
    {
        Navigation.NavigateTo($"/add-item/{item.Id}");
    }

    private void ConfirmDelete(InventoryResponse item)
    {
        deleteItem = item;
        errorMessage = string.Empty;
    }

    private void CancelDelete()
    {
        deleteItem = null;
        errorMessage = string.Empty;
    }

    private async Task DeleteConfirmed()
    {
        if (deleteItem == null)
            return;

        var response = await Http.DeleteAsync($"api/inventory/deleteInventory/{deleteItem.Id}");
        if (response.IsSuccessStatusCode)
        {
            categoryItems?.Remove(deleteItem);
            filteredItems?.Remove(deleteItem);

            if (categoryToSell != null && groupedInventoryItems != null)
            {
                var group = groupedInventoryItems.Find(c => c.Category == categoryToSell);
                if (group != null)
                {
                    var room = group.Rooms.Find(r => r.RoomName == deleteItem.RoomName);
                    if (room != null)
                    {
                        room.TotalQuantity -= deleteItem.Quantity;
                        if (room.TotalQuantity <= 0)
                        {
                            group.Rooms.Remove(room);
                        }
                    }

                    if (!group.Rooms.Any())
                    {
                        groupedInventoryItems.Remove(group);
                    }
                }
            }

            deleteItem = null;
            errorMessage = string.Empty;

            if (filteredItems != null && PaginatedItems.Count() == 0 && CurrentPage > 1)
            {
                CurrentPage--;
            }
        }
        else
        {
            var apiMessage = await response.Content.ReadAsStringAsync();
            errorMessage = string.IsNullOrWhiteSpace(apiMessage) ? "Delete operation failed." : apiMessage;
        }
    }

    private void OpenMultiSellSection()
    {
        if (!SelectedItems.Any()) return;

        buyerName = string.Empty;
        pricePerMeter = 0m;
        errorMessage = string.Empty;
        showMultiSellSection = true;
    }

    private void CancelMultiSell()
    {
        showMultiSellSection = false;

        if (filteredItems != null)
        {
            foreach (var item in filteredItems)
                item.IsSelected = false;
        }
    }

    private async Task ConfirmMultiSale()
    {
        showConfirmDialog = false;
        if (!CanConfirmMultiSale)
        {
            errorMessage = "Please fill all required fields.";
            return;
        }

        var itemsToSell = SelectedItems.ToList();

        if (itemsToSell.Count == 1)
        {
            // Single sale API call
            var item = itemsToSell[0];
            var saleDto = new SalesCreateDBO
                {
                    InventoryId = item.Id,
                    SoldTo = buyerName,
                    UnitPrice = pricePerMeter
                };

            var response = await Http.PostAsJsonAsync("api/sale/createSale", saleDto);

            if (response.IsSuccessStatusCode)
            {
                RemoveSoldItemFromLists(item);
            }
            else
            {
                errorMessage = "Failed to record sale.";
                return;
            }
        }
        else
        {
            // Batch sale API call
            var salesToCreate = itemsToSell.Select(item => new SalesCreateDBO
                {
                    InventoryId = item.Id,
                    SoldTo = buyerName,
                    UnitPrice = pricePerMeter
                }).ToList();

            var response = await Http.PostAsJsonAsync("api/sale/createBatchSales", salesToCreate);

            if (response.IsSuccessStatusCode)
            {
                foreach (var item in itemsToSell)
                {
                    RemoveSoldItemFromLists(item);
                }
            }
            else
            {
                errorMessage = "Failed to record batch sale.";
                return;
            }
        }

        CancelMultiSell();
    }

    private void RemoveSoldItemFromLists(InventoryResponse item)
    {
        categoryItems?.Remove(item);
        filteredItems?.Remove(item);

        var group = groupedInventoryItems?.Find(c => c.Category == categoryToSell);
        if (group != null)
        {
            var room = group.Rooms.Find(r => r.RoomName == item.RoomName);
            if (room != null)
            {
                room.TotalQuantity -= item.Quantity;
                if (room.TotalQuantity <= 0)
                {
                    group.Rooms.Remove(room);
                }
            }

            if (!group.Rooms.Any())
            {
                groupedInventoryItems.Remove(group);
            }
        }
    }

    private void CloseDialog()
    {
        showDialog = false;
        showConfirmDialog = false; 
        categoryToSell = null;
        categoryItems = null;
        filteredItems = null;
        deleteItem = null;
        buyerName = string.Empty;
        errorMessage = string.Empty;
        pricePerMeter = 0m;
        filterRoom = string.Empty;
        filterDate = null;
        showMultiSellSection = false;
        CurrentPage = 1;
    }

    // Pagination methods
    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            StateHasChanged();
        }
    }
}
